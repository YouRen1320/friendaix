{
  "name": "friendaix-workspace",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "FriendAIX CLI and reusable configuration engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "npm run check --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run build --workspace=friendaix-core && npm run dev --workspace=friendaix",
    "pack:check": "node scripts/check-packages.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.18"
  }
}
