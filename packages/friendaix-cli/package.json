{
  "name": "friendaix",
  "version": "0.3.0",
  "description": "友人 AI 助手 — 安全配置 Claude Code / Codex / OpenCode",
  "type": "module",
  "bin": {
    "friendaix": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
