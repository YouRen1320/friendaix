    "start": "node dist/cli.js",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "cli",
    "claude-code",
    "codex",
    "opencode",
    "friendaix",
    "npx"
  ],
  "license": "MIT",
  "author": "YouR.AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YouRen1320/friendaix.git",
    "directory": "packages/friendaix-cli"
  },
  "bugs": {
    "url": "https://github.com/YouRen1320/friendaix/issues"
  },
  "homepage": "https://github.com/YouRen1320/friendaix#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "friendaix-core": "0.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
